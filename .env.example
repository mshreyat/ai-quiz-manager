# QuizForge AI - Environment Variables Template
# Copy this file to .env in the root or server directory and populate actual values.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# For Supabase, use the Session Pooler connection URL
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# AI Quiz Generation (Google Gemini or external LLM API)
GEMINI_API_KEY="your_gemini_api_key_here"

# Authentication
JWT_SECRET="your_jwt_secret_change_in_production"

# Supabase Auth Configuration (Backend Server)
# Keep SUPABASE_SERVICE_ROLE_KEY confidential - NEVER expose to the frontend client
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Frontend Configuration (Used by Vite client - public anon key only)
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
