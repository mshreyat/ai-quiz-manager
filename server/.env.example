PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"
GEMINI_API_KEY="your_gemini_api_key_here"
JWT_SECRET="your_jwt_secret_change_in_production"

# Supabase Auth Configuration (Backend Server)
# Keep SUPABASE_SERVICE_ROLE_KEY confidential - NEVER expose to the frontend client
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
